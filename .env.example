# Core application (required)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=inr

# Phone/WhatsApp authentication (required for production login)
OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_LOGIN_EMAIL_DOMAIN=wa.nutranza.local
MARK360_API_URL=
MARK360_API_KEY=
MARK360_SENDER_ID=
MARK360_TEMPLATE_ID=

# Local-only admin login shortcut. It is forcibly disabled in production.
ENABLE_MOCK_ADMIN_AUTH=false
MOCK_ADMIN_MOBILE=
MOCK_ADMIN_OTP=
MOCK_ADMIN_EMAIL=

# Optional integrations. Keep the corresponding flag false until configured.
FEATURE_PAYMENTS=false
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_MERCHANT_SALT=
EASEBUZZ_ENVIRONMENT=test

FEATURE_LOGISTICS=false
TRIVARA_BASE_URL=
TRIVARA_API_KEY=
TRIVARA_API_SECRET=

FEATURE_MEDIA_UPLOADS=false
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

FEATURE_EMAIL=false
BREVO_API_KEY=
CONTACT_FORM_RECIPIENT=
CONTACT_FORM_SENDER=

FEATURE_VISUAL_SEARCH=false
NEXT_PUBLIC_VISUAL_SEARCH_ENABLED=false

# Optional analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CONTENTSQUARE_ID=

# One-time owner bootstrap script inputs (never expose these publicly)
NUTRANZA_OWNER_EMAIL=
NUTRANZA_OWNER_PASSWORD=
NUTRANZA_OWNER_FIRST_NAME=
NUTRANZA_OWNER_LAST_NAME=
NUTRANZA_OWNER_PHONE=
